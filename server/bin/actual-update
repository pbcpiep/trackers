#!/usr/bin/env bash
# Update Actual Budget to a new version, taking a backup first.
#   sudo actual-update 26.10.0
# Versions: https://github.com/actualbudget/actual/releases
set -euo pipefail
ACTUAL_DIR=/opt/actual
CONFIG="${ACTUAL_BACKUP_CONFIG:-/etc/default/actual-backup}"
[ -r "$CONFIG" ] && . "$CONFIG"
[ "$(id -u)" = 0 ] || [ -n "${ACTUAL_BACKUP_CONFIG:-}" ] || { echo "Run with sudo: sudo actual-update <version>" >&2; exit 1; }
ver="${1:-}"
[[ "$ver" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Usage: sudo actual-update <version>, e.g. 26.10.0" >&2; exit 1; }
cur="$(sed -n 's/.*actual-server:\([0-9.]*\).*/\1/p' "$ACTUAL_DIR/compose.yaml")"
echo "Current version: ${cur:-unknown}  ->  new version: $ver"
actual-backup
cp "$ACTUAL_DIR/compose.yaml" "$ACTUAL_DIR/compose.yaml.bak"
sed -i "s|\(actualbudget/actual-server:\)[0-9.]*|\1$ver|" "$ACTUAL_DIR/compose.yaml"
cd "$ACTUAL_DIR"
if ! docker compose -f compose.yaml pull actual; then
  mv compose.yaml.bak compose.yaml
  echo "Could not download version $ver (typo?). Nothing was changed." >&2
  exit 1
fi
docker compose -f compose.yaml up -d actual
echo "Updated to $ver. If anything looks wrong: restore compose.yaml.bak and run 'sudo actual-restore'."
